{
  "name": "@tekrom/tsoft-app-gate",
  "version": "0.2.0",
  "description": "T-Soft paneli içinde açılan uygulamalar için App Bridge istemcisi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/tsoft-app-gate.min.js"
  },
  "unpkg": "./dist/tsoft-app-gate.min.js",
  "jsdelivr": "./dist/tsoft-app-gate.min.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --format=iife --global-name=TSoftAppGate --target=es2018 --minify --outfile=dist/tsoft-app-gate.min.js",
    "test": "npm run build && node --test test/",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tekrom/tsoft-app-gate"
  },
  "keywords": [
    "tsoft",
    "app-gate",
    "app-bridge",
    "embedded-app"
  ],
  "author": "T-Soft",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
